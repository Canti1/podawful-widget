{
  "name": "podawful-widget",
  "version": "0.1.0",
  "private": true,
  "description": "Unofficial fan-made PodAwful / goons tracker widget",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "allowScripts": {
    "electron@33.2.1": true
  },
  "build": {
    "appId": "com.personal.podawful-widget",
    "productName": "PodAwful Widget",
    "files": [
      "src/**",
      "assets/**",
      "goons.json",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/clickhead.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PodAwful Widget"
    }
  }
}
